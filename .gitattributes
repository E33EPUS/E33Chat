# 行尾策略：默认按文本处理、入库统一 LF（校验脚本与 CI 都按这个前提跑）
* text=auto

# gradle wrapper 脚本必须保持各自平台的行尾（gradlew 是 shell 脚本，坏了 Linux 起不来）
gradlew text eol=lf
platforms/*/gradlew text eol=lf
*.bat text eol=crlf

# 我们自己的 shell 脚本：bash 吃不下 CRLF（build_all.sh 首跑就栽过）
tools/*.sh text eol=lf

# datagen 的缓存与产物永远 LF，避免「只有行尾不同」的假变更
**/src/generated/**/.cache/* text eol=lf
**/src/generated/**/*.json text eol=lf
